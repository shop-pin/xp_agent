{
  "name": "mini-claude-mine",
  "version": "1.0.0",
  "description": "My from-scratch mini Claude Code, built chapter by chapter",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "mock": "tsc && node run-mock.mjs",
    "live": "tsc && node run-live.mjs",
    "cordis": "tsc && node --test \"dist/cordis-tests/*.test.js\"",
    "snapshot": "tsc && node run-snapshot.mjs",
    "snapshot:record": "tsc && node run-snapshot.mjs --record",
    "webui": "vite build webui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^5.6.2",
    "glob": "^13.0.6",
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  }
}
