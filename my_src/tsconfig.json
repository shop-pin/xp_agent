{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "*.ts",
    "backtest/**/*.ts",
    "cordis/**/*.ts",
    "cordis-tests/**/*.ts",
    "services/**/*.ts",
    "plugins/**/*.ts",
    "webui/**/*.ts",
    "webui/**/*.tsx"
  ]
}